# Trino connection of the API (all required, no defaults: the caller decides
# which data is read). Load locally with `uv run --env-file .env ...`.
API_TRINO_HOST=localhost
API_TRINO_PORT=443
# Password auth (ldap) requires https; for an unauthenticated local Trino use
# API_TRINO_AUTH_METHOD=none and API_TRINO_HTTP_SCHEME=http
API_TRINO_HTTP_SCHEME=https
API_TRINO_AUTH_METHOD=ldap
API_TRINO_USER=your-user
API_TRINO_PASSWORD=your-password
# Trino catalog and schema of the dbt api_* views (dataware dbt project:
# <target schema>_api, e.g. dataware_dev_api or dataware_api)
API_TRINO_CATALOG=iceberg
API_DATAWARE_SCHEMA=dataware_dev_api
