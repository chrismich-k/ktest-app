BKG_ICEBERG_REST_URI=http://localhost:9001/iceberg
BKG_ICEBERG_WAREHOUSE=s3a://your-bucket/warehouse
BKG_ICEBERG_NAMESPACE=bkg

BKG_S3_ENDPOINT=http://localhost:9000
BKG_S3_ACCESS_KEY_ID=your-access-key
BKG_S3_SECRET_ACCESS_KEY=your-secret-key

# Read-only raw-archive source (rustfs "raw-data" bucket, dedicated "raw-r"
# read-only user - deliberately separate from the write-path S3 credentials
# above, even if the endpoint happens to be the same host).
BKG_RAW_S3_ENDPOINT=http://localhost:9000
BKG_RAW_S3_ACCESS_KEY_ID=your-raw-read-access-key
BKG_RAW_S3_SECRET_ACCESS_KEY=your-raw-read-secret-key

BKG_RAW_S3_BUCKET=raw-data
BKG_RAW_S3_PREFIX=bkg
