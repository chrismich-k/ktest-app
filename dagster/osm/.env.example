OSM_ICEBERG_REST_URI=http://localhost:9001/iceberg
OSM_ICEBERG_WAREHOUSE=s3a://your-bucket/warehouse
OSM_ICEBERG_NAMESPACE=osm

OSM_S3_ENDPOINT=http://localhost:9000
OSM_S3_ACCESS_KEY_ID=your-access-key
OSM_S3_SECRET_ACCESS_KEY=your-secret-key

# User-Agent for requests to GitHub (API and release downloads); GitHub
# rejects API requests without one.
OSM_USER_AGENT="ktest-osm/0.1 (+https://github.com/your-org/ktest-app)"
