# Hive Metastore Iceberg REST Catalog (via kubectl port-forward or similar tunnel)
DATAWARE_ICEBERG_REST_URI=http://localhost:9001/iceberg

# Iceberg warehouse location (S3/MinIO-compatible object store in the cluster)
DATAWARE_ICEBERG_WAREHOUSE=s3a://your-bucket/warehouse
DATAWARE_ICEBERG_NAMESPACE=dataware_dev

DATAWARE_S3_ENDPOINT=http://localhost:9000
DATAWARE_S3_ACCESS_KEY_ID=your-access-key
DATAWARE_S3_SECRET_ACCESS_KEY=your-secret-key

# --- dbt / Trino (dbt/profiles.yml) ---
# dbt target: dev | prod
DATAWARE_DBT_TARGET=dev
DATAWARE_TRINO_HOST=localhost
DATAWARE_TRINO_PORT=443
# Password auth (ldap) requires https; for an unauthenticated local Trino use
# DATAWARE_TRINO_AUTH_METHOD=none and DATAWARE_TRINO_HTTP_SCHEME=http
DATAWARE_TRINO_HTTP_SCHEME=https
DATAWARE_TRINO_AUTH_METHOD=ldap
DATAWARE_TRINO_USER=your-user
DATAWARE_TRINO_PASSWORD=your-password
# Trino catalog backed by the Iceberg REST catalog
DATAWARE_TRINO_CATALOG=iceberg
# Target schema per dbt target (custom schemas get appended, e.g. _staging).
# Set only the one(s) you intend to write to: running a target whose schema
# variable is unset fails instead of writing somewhere unintended.
DATAWARE_TRINO_SCHEMA_DEV=dataware_dev
#DATAWARE_TRINO_SCHEMA_PROD=dataware
# Schema the smard code location writes its raw tables to
DATAWARE_SMARD_SCHEMA=smard
DATAWARE_TRADINGHUB_EU_SCHEMA=tradinghub_eu
DATAWARE_BKG_SCHEMA=bkg
