# Hive Metastore Iceberg REST Catalog (via kubectl port-forward or similar tunnel)
MASTR_ICEBERG_REST_URI=http://localhost:9001/iceberg

# Iceberg warehouse location (S3/MinIO-compatible object store in the cluster)
MASTR_ICEBERG_WAREHOUSE=s3a://your-bucket/warehouse

# Iceberg namespace (must already exist in the catalog - not created by this
# code location). Required, no default.
MASTR_ICEBERG_NAMESPACE=mastr

MASTR_S3_ENDPOINT=http://localhost:9000
MASTR_S3_ACCESS_KEY_ID=your-access-key
MASTR_S3_SECRET_ACCESS_KEY=your-secret-key

# Read-only raw-archive source (rustfs "raw-data" bucket, dedicated "raw-r"
# read-only user - deliberately separate from the write creds above, even
# if the endpoint happens to be the same host).
MASTR_RAW_S3_ENDPOINT=http://localhost:9000
MASTR_RAW_S3_ACCESS_KEY_ID=your-raw-read-access-key
MASTR_RAW_S3_SECRET_ACCESS_KEY=your-raw-read-secret-key

# Bucket + prefix the Gesamtdatenexport archives are deposited under, as
# raw-data/<prefix>/stichtag=<YYYY-MM-DD>/Gesamtdatenexport_*.zip, with a
# "_SUCCESS" marker object written once the upload is complete.
MASTR_RAW_S3_BUCKET=raw-data
MASTR_RAW_S3_PREFIX=mastr
