# Hive Metastore Iceberg REST Catalog (via kubectl port-forward or similar tunnel)
TRADINGHUB_EU_ICEBERG_REST_URI=http://localhost:9001/iceberg

# Iceberg warehouse location (S3/MinIO-compatible object store in the cluster)
TRADINGHUB_EU_ICEBERG_WAREHOUSE=s3a://your-bucket/warehouse

# Iceberg namespace (must already exist in the catalog - not created by this
# code location). Required, no default.
TRADINGHUB_EU_ICEBERG_NAMESPACE=tradinghub_eu

TRADINGHUB_EU_S3_ENDPOINT=http://localhost:9000
TRADINGHUB_EU_S3_ACCESS_KEY_ID=your-access-key
TRADINGHUB_EU_S3_SECRET_ACCESS_KEY=your-secret-key

# User-Agent header sent on every request to Trading Hub Europe's DataExport API.
# Required per https://api.tradinghub.eu/api/dataexport/manual/de (RFC 7231 §5.5.3 format).
THE_USER_AGENT="ktest-tradinghub-eu/0.1 (+https://github.com/your-org/ktest-app)"
